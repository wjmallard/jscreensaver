#!/bin/sh
# GitHub Pages deploys every push whether or not CI is green, so lint and the
# catalog staleness check run here, before the deploy.
set -e
if [ -x node_modules/.bin/biome ]; then
  node_modules/.bin/biome lint .
else
  echo "pre-push: Biome not installed (npm ci); skipping lint" >&2
fi
exec node tools/build-catalog.mjs --check
